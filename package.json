{
  "name": "dsrv-vscode",
  "displayName": "DSRV Language Support",
  "description": "Language support for the RoboSAPIENS trustworthiness checker. Includes syntax highlighting, completion, diagnostics, and testing support for DSRV runtime verification specifications.",
  "version": "1.0.0",
  "publisher": "intocps",
  "repository": {
    "url": "https://github.com/INTO-CPS-Association/dsrv-vscode.git",
    "type": "git"
  },
  "icon": "./assets/robosapiens-monitor-128.png",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.107.0"
  },
  "keywords": [
    "dsrv",
    "runtime verification",
    "runtime monitoring",
    "stream runtime verification",
    "formal methods",
    "cyber-physical systems",
    "robotics",
    "trustworthiness checker",
    "robosapiens"
  ],
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:dsrv"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dsrv",
        "aliases": [
          "DSRV",
          "dsrv"
        ],
        "icon": {
          "light": "./assets/robosapiens-monitor-32.png",
          "dark": "./assets/robosapiens-monitor-32.png"
        },
        "extensions": [
          ".dsrv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dsrv",
        "scopeName": "source.dsrv",
        "path": "./syntaxes/dsrv.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "DSRV",
      "properties": {
        "DSRV.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `trustworthiness_checker` executable. May be a file, a directory to search, or a command available on `PATH`. Relative paths are resolved from the workspace root. When empty, the copy bundled with the extension is used, falling back to `PATH`",
          "scope": "machine-overridable"
        },
        "DSRV.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `dsrv-lsp` executable. Same resolution rules as `#DSRV.binaryPath#`.",
          "scope": "machine-overridable"
        },
        "DSRV.semantics": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "untimed",
            "typed-untimed",
            "causal"
          ],
          "enumItemLabels": [
            "Checker default",
            "untimed",
            "typed-untimed",
            "causal"
          ],
          "enumDescriptions": [
            "Pass no --semantics at all, so the checker's own default applies.",
            "Gradual typing: checks annotations, infers missing types, and uses type information during evaluation where supported.",
            "Strict typing: requires annotations on all stream variables.",
            "Produces values with causal sets identifying supporting input observations. Requires the semi-sync runtime, which the extension selects for you."
          ],
          "markdownDescription": "Semantics used when running a DSRV model. Leave as **Checker default** to pass no `--semantics` flag, so the checker's own default applies.",
          "scope": "resource"
        },
        "DSRV.runtime": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "semi-sync",
            "dataflow"
          ],
          "enumItemLabels": [
            "Checker default",
            "semi-sync",
            "dataflow"
          ],
          "enumDescriptions": [
            "Pass no --runtime at all, so the checker's own default applies.",
            "Semi-synchronous runtime. Required by the causal semantics.",
            "Dataflow runtime."
          ],
          "markdownDescription": "Runtime used when running a DSRV model. The empty default passes no `--runtime`.\n\nIgnored when `#DSRV.semantics#` is set to `causal`, which only works under `semi-sync`; the extension passes that runtime regardless of this setting.",
          "scope": "resource"
        },
        "dsrv-lsp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "markdownDescription": "Traces the communication between VS Code and the DSRV language server.",
          "scope": "window"
        }
      }
    },
    "commands": [
      {
        "command": "DSRV.run",
        "title": "Run Model",
        "category": "DSRV",
        "icon": "$(play)"
      },
      {
        "command": "DSRV.runWith",
        "title": "Run Model With...",
        "category": "DSRV",
        "icon": "$(play)"
      },
      {
        "command": "DSRV.selectSemantics",
        "title": "Select Semantics",
        "category": "DSRV"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "DSRV.run",
          "when": "resourceLangId == dsrv && !inDiffEditor",
          "group": "navigation@0"
        },
        {
          "command": "DSRV.runWith",
          "when": "resourceLangId == dsrv && !inDiffEditor",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        { "command": "DSRV.run", "when": "resourceLangId == dsrv" },
        { "command": "DSRV.runWith", "when": "resourceLangId == dsrv" },
        { "command": "DSRV.selectSemantics", "when": "resourceLangId == dsrv" }
      ]
    },
    "configurationDefaults": {
      "[dsrv]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --minify",
    "build": "npm run build-base -- --sourcemap",
    "build-debug": "npm run build-base -- --sourcemap",
    "test:all": "npm run test:ts",
    "test:ts": "npm run build-base && vscode-test",
    "build-base": "node esbuild.js",
    "package": "vsce package",
    "check-types": "tsc --noEmit",
    "watch:esbuild": "npm run build-base -- --sourcemap --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "lint": "eslint client/src extension.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "mocha": "^11.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
